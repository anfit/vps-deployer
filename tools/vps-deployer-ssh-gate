#!/usr/bin/env python3
"""Forced-command gate for vps-deployer's dedicated privileged SSH key."""
from __future__ import annotations

import base64
import json
import os
from pathlib import PurePosixPath
import re
import shutil
import sys

SAFE_TOKEN = re.compile(r"^[A-Za-z0-9_.:@%+=,/ -]+$")
SAFE_UNIT = re.compile(r"^vps-deployer-[a-z][a-z0-9-]{0,62}\.service$")
ALLOWED_COMMANDS = {"cat", "chmod", "chown", "find", "install", "ln", "mkdir", "nginx", "readlink", "rm",
                    "systemctl", "tar", "test", "useradd"}
PATH_ROOTS = ("/srv/vps-deployer", "/etc/vps-deployer", "/etc/nginx/sites-available/",
              "/etc/nginx/sites-enabled/", "/var/lib/", "/tmp/vps-deployer-")


def allowed_path(value: str) -> bool:
    path = PurePosixPath(value)
    if not path.is_absolute() or ".." in path.parts:
        return False
    text = str(path)
    return text.startswith(PATH_ROOTS) or (
        text.startswith("/etc/systemd/system/vps-deployer-") and text.endswith(".service")
    )


def validate(argv: list[str]) -> None:
    if not argv or argv[0] not in ALLOWED_COMMANDS or any(not isinstance(x, str) or "\x00" in x for x in argv):
        raise ValueError("command is not allowed")
    if argv[0] == "systemctl":
        if argv[1:] in (["daemon-reload"], ["reset-failed"]):
            return
        if argv[1:] == ["reload", "nginx"]:
            return
        if len(argv) >= 3 and argv[1] in {"enable", "disable", "restart", "start", "stop", "status", "is-active"}:
            units = [x for x in argv[2:] if not x.startswith("-")]
            if units and all(SAFE_UNIT.fullmatch(x) for x in units):
                return
        raise ValueError("systemctl operation is not allowed")
    if argv[0] == "nginx":
        if argv[1:] == ["-t"]:
            return
        raise ValueError("nginx operation is not allowed")
    if argv[0] == "useradd":
        if len(argv) >= 2 and re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", argv[-1]) and argv[-1] != "root":
            return
        raise ValueError("user is not allowed")
    path_args = [x for x in argv[1:] if x.startswith("/")]
    if not path_args or not all(allowed_path(x) or x == "/usr/sbin/nologin" for x in path_args):
        raise ValueError("path is outside vps-deployer ownership")
    if any(not SAFE_TOKEN.fullmatch(x) for x in argv if not x.startswith("/")):
        raise ValueError("argument contains unsafe characters")


def main() -> None:
    original = os.environ.get("SSH_ORIGINAL_COMMAND", "")
    match = re.fullmatch(r"vps-deployer-exec ([A-Za-z0-9_=-]+)", original)
    if not match:
        raise ValueError("interactive access is disabled")
    argv = json.loads(base64.urlsafe_b64decode(match.group(1)))
    validate(argv)
    executable = shutil.which(argv[0])
    if not executable:
        raise ValueError("executable unavailable")
    os.execv(executable, argv)


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"vps-deployer gate: {exc}", file=sys.stderr)
        raise SystemExit(126)
