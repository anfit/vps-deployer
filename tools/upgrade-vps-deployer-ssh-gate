#!/bin/sh
set -eu

managed_root=/srv/vps-deployer
authorized_keys=/root/.ssh/authorized_keys
gate_target=/usr/local/sbin/vps-deployer-ssh-gate
storage_args=

usage() {
    echo "usage: $0 [--managed-root PATH] [--storage PATH]... [--authorized-keys PATH] [--gate-target PATH]" >&2
    exit 2
}

safe_arg() {
    case "$1" in
        ""|*[!A-Za-z0-9_./:@%+=,-]*) echo "error: unsupported character in an argument" >&2; exit 2 ;;
    esac
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --managed-root|--storage|--authorized-keys|--gate-target)
            [ "$#" -ge 2 ] || usage
            option=$1
            value=$2
            safe_arg "$value"
            shift 2
            ;;
        *) usage ;;
    esac
    case "$option" in
        --managed-root) managed_root=$value ;;
        --storage) storage_args="$storage_args --storage $value" ;;
        --authorized-keys) authorized_keys=$value ;;
        --gate-target) gate_target=$value ;;
    esac
done

[ "$(id -u)" -eq 0 ] || { echo "error: run this upgrade as root" >&2; exit 1; }
case "$managed_root" in /*) ;; *) echo "error: managed root must be absolute" >&2; exit 2 ;; esac

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
gate_source=$script_dir/vps-deployer-ssh-gate
[ -f "$gate_source" ] || { echo "error: place vps-deployer-ssh-gate beside this script" >&2; exit 1; }

install -o root -g root -m 0755 "$gate_source" "$gate_target"

if [ ! -f "$authorized_keys" ]; then
    echo "gate installed; no authorized_keys file at $authorized_keys"
    exit 0
fi

matches=$(grep -c 'command="[^"]*vps-deployer-ssh-gate' "$authorized_keys" || true)
if [ "$matches" -eq 0 ]; then
    echo "gate installed; no existing forced-command entry found"
    exit 0
fi
[ "$matches" -eq 1 ] || { echo "error: expected one gate entry, found $matches" >&2; exit 1; }

backup=$authorized_keys.vps-deployer-backup.$(date -u +%Y%m%dT%H%M%SZ)
temp=$authorized_keys.vps-deployer-new.$$
cp -p "$authorized_keys" "$backup"
command_value="$gate_target --managed-root $managed_root$storage_args"
awk -v replacement="command=\"$command_value\"" '
    /command="[^"]*vps-deployer-ssh-gate/ {
        sub(/command="[^"]*vps-deployer-ssh-gate[^"]*"/, replacement)
    }
    { print }
' "$authorized_keys" > "$temp"
chown --reference="$authorized_keys" "$temp"
chmod --reference="$authorized_keys" "$temp"
mv "$temp" "$authorized_keys"

echo "installed $gate_target"
echo "updated $authorized_keys"
echo "backup $backup"
